# Replit configuration — npm + Next.js 15. See WORKFLOW.md and replit.md.
#
# GitHub Import is NOT safe: when package.json depends on `next`, Replit
# auto-starts Agent "Port imported Vercel app" (PNPM_WORKSPACE port). Use
# a Blank Repl + git overlay to attach mizlaa/doorlink instead.

run = "npm run dev -- --hostname 0.0.0.0 --port $PORT"
entrypoint = "src/app/page.tsx"
modules = ["nodejs-22", "postgresql-16"]

hidden = [".next", "node_modules"]

language = "nodejs"

[packager]
language = "nodejs"

[packager.features]
guessImports = false
packageSearch = true

[nix]
channel = "stable-24_05"

[env]
PORT = "3000"

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm run start -- --hostname 0.0.0.0 --port $PORT"]

[[ports]]
localPort = 3000
externalPort = 80

[gitHubImport]
requiredFiles = [".replit", "package.json", "next.config.mjs"]
