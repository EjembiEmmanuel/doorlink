// DoorLink — relational schema.
// Provenance is a first-class concern: every catalogue record carries a
// DataSource so the UI can render an honest caution badge instead of
// pretending demo or imported data is verified (brief rules 28, 35).
// Money is stored as integer minor units throughout — no float drift in
// a multi-vendor marketplace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum Role {
  CUSTOMER
  TECHNICIAN
  SUPPLIER
  MANUFACTURER
  ADMIN
}

enum OrgType {
  SUPPLIER
  MANUFACTURER
  TECHNICIAN_COMPANY
}

enum OrgMemberRole {
  OWNER
  STAFF
}

// Where a catalogue record actually came from. Rendered by <SourceBadge />
// wherever the record appears — never inferred, never hidden.
enum DataSource {
  DEMO
  MANUFACTURER_VERIFIED
  ADMIN_VERIFIED
  COMMUNITY_SUBMITTED
  IMPORTED
}

enum DocumentKind {
  INSTALL_MANUAL
  USER_MANUAL
  WIRING_DIAGRAM
  PARTS_LIST
  SPEC_SHEET
  WARRANTY
  SERVICE_BULLETIN
  PROGRAMMING_GUIDE
  TROUBLESHOOTING_GUIDE
  TECHNICAL_DOCUMENT
  SAFETY_DOCUMENT
  QUICK_START
  DECLARATION_OF_CONFORMITY
}

// Where a document physically came from, kept separate from DataSource
// (which describes how much we trust the *catalogue record*). A manual
// scraped off an installer's website is a real, useful document even
// though it is not the manufacturer's own file — conflating the two
// would let third-party content present itself as official.
enum DocumentOrigin {
  MANUFACTURER_ORIGINAL
  THIRD_PARTY_GUIDE
  COMMUNITY_CONTRIBUTED
  DOORLINK_AUTHORED
  UNKNOWN
}

enum CompatibilityKind {
  REPLACEMENT_PART
  ACCESSORY
  REMOTE_PAIR
  CONTROL_BOARD_MATCH
  MOTOR_MATCH
}

enum CompatibilityConfidence {
  CONFIRMED
  LIKELY
  UNCONFIRMED
}

enum ListingCondition {
  NEW
  REFURBISHED
  USED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
  OPEN_FOR_QUOTES
  QUOTED
  ASSIGNED
  EXPIRED
  CANCELLED
}

enum JobStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ACCEPTED
  AWAITING_PAYMENT
  DISPUTED
}

enum UrgencyLevel {
  EMERGENCY
  URGENT
  STANDARD
  FLEXIBLE
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum VerificationStatus {
  UNVERIFIED
  SUBMITTED
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum TransactionStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PAID
  FAILED
  CANCELLED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  WEEK
  MONTH
  YEAR
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

enum ReportTargetType {
  USER
  LEAD
  JOB
  MESSAGE
  LISTING
  REVIEW
}

enum SupportStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  ORDER_UPDATE
  LEAD_ASSIGNED
  DOCUMENT_UPDATED
  SUPPORT_REPLY
  SYSTEM
  LEAD_MATCHED
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  JOB_SCHEDULED
  JOB_REMINDER
  JOB_COMPLETED
  MESSAGE_RECEIVED
  PAYMENT_STATUS
  PAYOUT_STATUS
  SUBSCRIPTION_STATUS
  REVIEW_RECEIVED
  VERIFICATION_STATUS
}

enum ImportJobStatus {
  PENDING
  VALIDATING
  STAGED
  APPLIED
  REJECTED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  APPLIED
}

// ---------------------------------------------------------------------
// Identity and organisations
// ---------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(CUSTOMER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       OrganizationMember[]
  technicianProfile TechnicianProfile?
  addresses         Address[]
  cart              Cart?
  orders            Order[]              @relation("OrderBuyer")
  reviews           Review[]
  favorites         Favorite[]
  listings          Listing[]
  assignedLeads     Lead[]
  jobs              Job[]                @relation("JobCustomer")
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  requestedLeads        Lead[]                    @relation("LeadCustomer")
  quotes                Quote[]                   @relation("QuoteWorker")
  workerJobs            Job[]                     @relation("JobWorker")
  jobStatusEvents       JobStatusEvent[]
  conversations         ConversationParticipant[]
  messages              Message[]
  reviewsWritten        WorkerReview[]            @relation("ReviewAuthor")
  reviewsReceived       WorkerReview[]            @relation("ReviewSubject")
  transactionsAsCustomer Transaction[]            @relation("TransactionCustomer")
  transactionsAsWorker  Transaction[]             @relation("TransactionWorker")
  payouts               Payout[]                  @relation("PayoutWorker")
  subscriptions         Subscription[]
  savedManuals          SavedManual[]
  doorConfigurations    DoorConfiguration[]
  disputesRaised        Dispute[]                 @relation("DisputeRaiser")
  reportsFiled          Report[]                  @relation("ReportAuthor")
  reportsReviewed       Report[]                  @relation("ReportReviewer")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         OrganizationMember[]
  supplierProfile SupplierProfile?
  manufacturer    Manufacturer?
  listings        Listing[]
  orderItems      OrderItem[]
  jobs            Job[]                @relation("JobOrganization")
  leads           Lead[]
  importJobs      ImportJob[]
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           OrgMemberRole @default(STAFF)
  createdAt      DateTime      @default(now())

  @@unique([organizationId, userId])
}

// The worker/technician side of the marketplace. `verified` stays a
// plain boolean set by an admin — it means "a Doorlink admin checked the
// supplied documents", never "a licensing authority confirmed this",
// which would require an integration that does not exist. The
// verificationStatus field tracks where in that manual process a worker
// sits.
model TechnicianProfile {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  verified    Boolean  @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationNote   String?
  verifiedAt  DateTime?

  businessName String?
  // The number a technician puts on the side of the van, which is often
  // not the number on their personal account record.
  businessPhone String?
  abn          String?
  avatarUrl    String?
  headline     String?
  bio          String?
  yearsExperience Int?

  licenceNumber   String?
  insurerName     String?
  insurancePolicyNumber String?
  insuranceExpiresAt    DateTime?

  serviceArea String?
  baseSuburb  String?
  baseState   String?
  basePostcode String?
  serviceRadiusKm Int?

  hourlyRateCents Int?
  calloutFeeCents Int?
  currency        String  @default("AUD")

  acceptingWork Boolean @default(true)

  // Denormalised rating cache, recomputed whenever a review lands.
  // Kept on the row because worker lists sort and filter on it, and
  // aggregating every review per card on every browse page would not
  // hold up.
  ratingAvg     Float?
  ratingCount   Int     @default(0)
  jobsCompleted Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs           Job[] @relation("JobTechnician")
  services       WorkerService[]
  serviceAreas   WorkerServiceArea[]
  availability   WorkerAvailability[]
  certifications WorkerCertification[]
}

model WorkerService {
  id         String   @id @default(cuid())
  worker     TechnicianProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId   String
  category   ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  fromPriceCents Int?
  note       String?
  createdAt  DateTime @default(now())

  @@unique([workerId, categoryId])
}

model WorkerServiceArea {
  id        String   @id @default(cuid())
  worker    TechnicianProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  suburb    String?
  state     String?
  postcode  String
  createdAt DateTime @default(now())

  @@unique([workerId, postcode])
  @@index([postcode])
}

model WorkerAvailability {
  id        String   @id @default(cuid())
  worker    TechnicianProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  // 0 = Sunday through 6 = Saturday, matching JS getDay().
  dayOfWeek Int
  startMinute Int
  endMinute   Int
  createdAt DateTime @default(now())

  @@unique([workerId, dayOfWeek, startMinute])
}

model WorkerCertification {
  id          String   @id @default(cuid())
  worker      TechnicianProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId    String
  name        String
  issuer      String?
  reference   String?
  fileKey     String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  // Admin-reviewed, same honesty boundary as TechnicianProfile.verified.
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SupplierProfile {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique
  commissionBps  Int          @default(0)
  verified       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------------------------------------------------------------------
// Catalogue tree
// ---------------------------------------------------------------------

model Manufacturer {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?       @unique
  name           String        @unique
  slug           String        @unique
  dataSource     DataSource    @default(DEMO)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  productLines ProductLine[]
  models       Model[]
  documents    Document[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  // Explicit Restrict — Prisma's default for an optional relation is
  // SetNull, which would silently orphan subcategories into top-level ones
  // on delete instead of blocking it like every other in-use catalogue
  // relation does.
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  parentId  String?
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  models    Model[]
  documents Document[]
}

model ProductLine {
  id             String       @id @default(cuid())
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  manufacturerId String
  name           String
  slug           String
  dataSource     DataSource   @default(DEMO)
  createdAt      DateTime     @default(now())

  models Model[]

  @@unique([manufacturerId, slug])
}

// The catalogue leaf: an opener, motor, remote, lock, or spare part.
// Every finder cascade ends here.
model Model {
  id             String       @id @default(cuid())
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  manufacturerId String
  category       Category     @relation(fields: [categoryId], references: [id])
  categoryId     String
  productLine    ProductLine? @relation(fields: [productLineId], references: [id])
  productLineId  String?
  name           String
  modelCode      String
  slug           String       @unique
  summary        String?
  dataSource     DataSource   @default(DEMO)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  specs          ModelSpec[]
  documents      Document[]
  listings       Listing[]
  compatibleFrom Compatibility[] @relation("CompatFrom")
  compatibleTo   Compatibility[] @relation("CompatTo")
  favorites      Favorite[]
  jobs           Job[]
  leads          Lead[]
  configurations DoorConfiguration[]

  @@unique([manufacturerId, modelCode])
}

model ModelSpec {
  id        String  @id @default(cuid())
  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId   String
  label     String
  value     String
  unit      String?
  sortOrder Int     @default(0)
}

// ---------------------------------------------------------------------
// Technical library
// ---------------------------------------------------------------------

// supersedesId forms a revision chain so an old installation keeps its
// correct manual instead of being shown the current one.
// A single document in the manuals library. modelId is optional because
// plenty of real documents (a keypad coding guide, a generic wiring
// sheet) belong to a manufacturer or category without a catalogue Model
// record existing for them yet — requiring one would mean either
// inventing model records or dropping usable documents.
model Document {
  id             String       @id @default(cuid())
  slug           String       @unique
  model          Model?       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId        String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  manufacturerId String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  categoryId     String?
  kind           DocumentKind
  title          String
  description    String?
  fileKey        String
  version        String       @default("1")

  // Printed on the document itself, not invented — a FAAC manual carries
  // a document code (732786) and a revision (Rev.C) which is how the
  // trade actually refers to a specific edition.
  documentCode   String?
  revision       String?
  language       String       @default("en")
  pageCount      Int?
  fileSizeBytes  Int?
  mimeType       String       @default("application/pdf")
  originalFilename String?

  origin         DocumentOrigin @default(UNKNOWN)
  publisher      String?
  sourceUrl      String?
  provenanceNote String?

  // Text extracted from the file at ingest, used for full-text search.
  // Never edited by hand — it is a copy of what the document says, so
  // search results can never claim content the document doesn't contain.
  searchText     String?

  dataSource     DataSource   @default(DEMO)
  isPublished    Boolean      @default(true)
  downloadCount  Int          @default(0)
  publishedAt    DateTime?

  supersedes   Document?    @relation("DocumentRevision", fields: [supersedesId], references: [id])
  supersedesId String?      @unique
  supersededBy Document?    @relation("DocumentRevision")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt @default(now())

  savedBy      SavedManual[]

  @@index([manufacturerId])
  @@index([categoryId])
  @@index([modelId])
  @@index([kind])
}

model SavedManual {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
}

// ---------------------------------------------------------------------
// Compatibility engine — a join table, never hardcoded in a component.
// Queried in both directions via compatibleFrom / compatibleTo.
// ---------------------------------------------------------------------

model Compatibility {
  id          String                  @id @default(cuid())
  fromModel   Model                   @relation("CompatFrom", fields: [fromModelId], references: [id], onDelete: Cascade)
  fromModelId String
  toModel     Model                   @relation("CompatTo", fields: [toModelId], references: [id], onDelete: Cascade)
  toModelId   String
  kind        CompatibilityKind
  confidence  CompatibilityConfidence @default(UNCONFIRMED)
  dataSource  DataSource              @default(DEMO)
  note        String?
  createdAt   DateTime                @default(now())

  @@unique([fromModelId, toModelId, kind])
}

// ---------------------------------------------------------------------
// Marketplace, cart, orders
// ---------------------------------------------------------------------

// A listing is sold by either a business (organizationId) or an
// individual peer-to-peer seller (sellerId) — never neither, enforced in
// the create/update actions rather than at the schema level (Prisma has
// no native "exactly one of two nullable columns" constraint).
model Listing {
  id             String            @id @default(cuid())
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  seller         User?             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId       String?
  model          Model             @relation(fields: [modelId], references: [id])
  modelId        String
  title          String
  priceCents     Int
  currency       String            @default("AUD")
  condition      ListingCondition  @default(NEW)
  status         ListingStatus     @default(DRAFT)
  stockQty       Int               @default(0)
  dataSource     DataSource        @default(DEMO)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
}

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  quantity  Int     @default(1)

  @@unique([cartId, listingId])
}

// OrderItem carries its own orgId and status so a multi-vendor basket
// fulfils per seller instead of as one monolithic order.
model Order {
  id                 String      @id @default(cuid())
  buyer              User        @relation("OrderBuyer", fields: [buyerId], references: [id])
  buyerId            String
  status             OrderStatus @default(PENDING_PAYMENT)
  totalCents         Int
  currency           String      @default("AUD")
  shippingAddress    Address?    @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId  String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id             String          @id @default(cuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  listing        Listing         @relation(fields: [listingId], references: [id])
  listingId      String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String
  quantity       Int
  unitPriceCents Int
  status         OrderItemStatus @default(PENDING)
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  line1     String
  line2     String?
  suburb    String
  state     String
  postcode  String
  country   String   @default("AU")
  createdAt DateTime @default(now())

  orders Order[]
}

model Review {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  rating    Int
  body      String?
  createdAt DateTime @default(now())

  @@unique([listingId, authorId])
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId   String
  createdAt DateTime @default(now())

  @@unique([userId, modelId])
}

// ---------------------------------------------------------------------
// Leads, jobs, support
// ---------------------------------------------------------------------

// A "request a technician" lead. Deliberately has no requester account
// link (name/email/phone are captured in the form itself) — submitting
// one never requires signing up, matching the low-friction, contact-by-
// email pattern the marketplace already uses. Claimed by either a
// technician's organization (assignedOrgId) or a technician personally
// (assignedUserId) — the same organization-or-individual duality as
// Listing, for the same reason: a technician doesn't need a registered
// business to pick up work.
// A customer's request for work — the entry point to the services
// marketplace. Contact fields stay on the row (rather than only on a
// linked account) because submitting a request has never required
// signing up, and making it require one now would lose the low-friction
// path that already works.
model Lead {
  id             String        @id @default(cuid())
  reference      String        @unique
  customer       User?         @relation("LeadCustomer", fields: [customerId], references: [id])
  customerId     String?
  name           String
  email          String
  phone          String?
  title          String?
  message        String

  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  serviceCategoryId String?

  suburb         String?
  state          String?
  postcode       String?

  urgency        UrgencyLevel  @default(STANDARD)
  preferredTiming String?
  budgetMinCents Int?
  budgetMaxCents Int?
  currency       String        @default("AUD")

  model          Model?        @relation(fields: [modelId], references: [id])
  modelId        String?
  assignedOrg    Organization? @relation(fields: [assignedOrgId], references: [id])
  assignedOrgId  String?
  assignedUser   User?         @relation(fields: [assignedUserId], references: [id])
  assignedUserId String?
  status         LeadStatus    @default(NEW)
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  photos         LeadPhoto[]
  quotes         Quote[]
  jobs           Job[]
  conversations  Conversation[]

  @@index([status])
  @@index([serviceCategoryId])
  @@index([postcode])
}

model LeadPhoto {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  fileKey   String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// The service types the marketplace trades in. A table rather than an
// enum so an admin can add "solar gate retrofit" later without a
// migration and a redeploy.
model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads          Lead[]
  workerServices WorkerService[]
}

// A worker's offer against a lead. amountCents is what the customer
// pays; the worker's take and Doorlink's commission are derived from it
// at acceptance time and snapshotted on the Transaction, so a later
// change to the platform commission rate can never silently rewrite the
// economics of a job already agreed.
model Quote {
  id           String      @id @default(cuid())
  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       String
  worker       User        @relation("QuoteWorker", fields: [workerId], references: [id], onDelete: Cascade)
  workerId     String
  amountCents  Int
  currency     String      @default("AUD")
  message      String
  estimatedDurationMinutes Int?
  availableFrom DateTime?
  validUntil   DateTime?
  status       QuoteStatus @default(PENDING)
  respondedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  job          Job?

  @@unique([leadId, workerId])
  @@index([status])
}

model Job {
  id             String             @id @default(cuid())
  reference      String             @unique
  lead           Lead?              @relation(fields: [leadId], references: [id])
  leadId         String?
  quote          Quote?             @relation(fields: [quoteId], references: [id])
  quoteId        String?            @unique
  technician     TechnicianProfile? @relation("JobTechnician", fields: [technicianId], references: [id])
  technicianId   String?
  worker         User?              @relation("JobWorker", fields: [workerId], references: [id])
  workerId       String?
  organization   Organization?      @relation("JobOrganization", fields: [organizationId], references: [id])
  organizationId String?
  customer       User?              @relation("JobCustomer", fields: [customerId], references: [id])
  customerId     String?
  model          Model?             @relation(fields: [modelId], references: [id])
  modelId        String?
  description    String
  status         JobStatus          @default(REQUESTED)
  agreedPriceCents Int?
  currency       String             @default("AUD")
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancellationReason String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  statusEvents   JobStatusEvent[]
  transactions   Transaction[]
  workerReview   WorkerReview?
  conversations  Conversation[]
  disputes       Dispute[]

  @@index([status])
  @@index([customerId])
  @@index([workerId])
}

// An append-only history of how a job moved through its lifecycle.
// Written alongside every status change so "who moved this to completed,
// and when" is answerable from data rather than inferred from timestamps
// scattered across the Job row.
model JobStatusEvent {
  id         String    @id @default(cuid())
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  fromStatus JobStatus?
  toStatus   JobStatus
  actor      User?     @relation(fields: [actorId], references: [id])
  actorId    String?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([jobId])
}

model SupportTicket {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  subject   String
  status    SupportStatus   @default(OPEN)
  priority  SupportPriority @default(NORMAL)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  messages SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  sender    User          @relation(fields: [senderId], references: [id])
  senderId  String
  body      String
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------------
// Notifications, audit log, staged imports, platform settings
// ---------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

// Nothing reaches the catalogue until an ImportJob is APPLIED — rows are
// staged and validated first.
model ImportJob {
  id             String          @id @default(cuid())
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  organizationId String?
  kind           String
  status         ImportJobStatus @default(PENDING)
  fileKey        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  rows ImportRow[]
}

model ImportRow {
  id          String          @id @default(cuid())
  importJob   ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importJobId String
  rowNumber   Int
  rawData     Json
  status      ImportRowStatus @default(PENDING)
  errors      Json?
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Idempotency record for inbound webhooks (Stripe, Resend, ...).
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

// ---------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------

// A thread between a customer and a worker. Optionally bound to the lead
// or job it concerns, so a conversation always has a subject rather than
// floating free — and so a job's whole paper trail can be pulled up in
// one query during a dispute.
model Conversation {
  id        String   @id @default(cuid())
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String?
  subject   String?
  lastMessageAt DateTime?
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([leadId])
  @@index([jobId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  fileKey   String
  filename  String?
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------

// Tied to a Job, one per job, and only writable once that job is
// actually COMPLETED — a review for work that never happened is the
// single easiest way to make a marketplace's ratings meaningless.
model WorkerReview {
  id         String   @id @default(cuid())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String   @unique
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  worker     User     @relation("ReviewSubject", fields: [workerId], references: [id], onDelete: Cascade)
  workerId   String
  rating     Int
  body       String?
  workerReply String?
  workerRepliedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workerId])
}

// ---------------------------------------------------------------------
// Payments, commission and payouts
// ---------------------------------------------------------------------

// One money movement for a job. The commission rate is snapshotted here
// (commissionRateBps) rather than read from settings at display time, so
// historical transactions keep reporting the split that was actually
// agreed even after an admin changes the platform rate.
model Transaction {
  id                String            @id @default(cuid())
  reference         String            @unique
  job               Job?              @relation(fields: [jobId], references: [id])
  jobId             String?
  customer          User?             @relation("TransactionCustomer", fields: [customerId], references: [id])
  customerId        String?
  worker            User?             @relation("TransactionWorker", fields: [workerId], references: [id])
  workerId          String?

  grossCents        Int
  commissionRateBps Int
  commissionCents   Int
  workerPayoutCents Int
  refundedCents     Int               @default(0)
  currency          String            @default("AUD")

  status            TransactionStatus @default(PENDING)
  provider          String?
  providerRef       String?
  failureReason     String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  events            TransactionEvent[]
  payout            Payout?

  @@index([status])
  @@index([jobId])
}

model TransactionEvent {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  type          String
  amountCents   Int?
  note          String?
  payload       Json?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model Payout {
  id            String       @id @default(cuid())
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String       @unique
  worker        User         @relation("PayoutWorker", fields: [workerId], references: [id])
  workerId      String
  amountCents   Int
  currency      String       @default("AUD")
  status        PayoutStatus @default(PENDING)
  provider      String?
  providerRef   String?
  paidAt        DateTime?
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([workerId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------

// Prices live in the database, not in code, because the brief fixes only
// the weekly price ($4.99 AUD) and leaves monthly/annual undecided —
// hard-coding a guess for those would bake a made-up number into the
// product.
model SubscriptionPlan {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  description   String?
  interval      BillingInterval
  priceCents    Int?
  currency      String          @default("AUD")
  trialDays     Int?
  features      Json?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  // Filled in once Stripe exists; null means this plan cannot be
  // subscribed to yet, and the UI says exactly that.
  stripePriceId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  planId               String
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelledAt          DateTime?
  provider             String?
  providerCustomerId   String?
  providerSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Configurator
// ---------------------------------------------------------------------

model DoorConfiguration {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  name      String
  // The chosen options as a JSON document. Deliberately schemaless: the
  // option set will change as real product data arrives, and a rigid
  // column per option would need a migration every time a finish is
  // added.
  spec      Json
  model     Model?   @relation(fields: [modelId], references: [id])
  modelId   String?
  shareSlug String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------
// Trust and safety
// ---------------------------------------------------------------------

model Dispute {
  id          String        @id @default(cuid())
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  raisedBy    User          @relation("DisputeRaiser", fields: [raisedById], references: [id])
  raisedById  String
  reason      String
  detail      String?
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Report {
  id          String           @id @default(cuid())
  reporter    User             @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      String
  detail      String?
  status      ReportStatus     @default(OPEN)
  reviewedBy  User?            @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([status])
  @@index([targetType, targetId])
}
